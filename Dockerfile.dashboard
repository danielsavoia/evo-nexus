# ============================================================
# EvoNexus Dashboard — Multi-stage Dockerfile
# Stage 1: Build React frontend
# Stage 2: Build terminal-server (native node-pty requires python3/make/g++)
# Stage 3: Python backend (Flask) + terminal-server + Node.js CLIs
# ============================================================

# --- Stage 1: Frontend build ---
FROM node:22-alpine AS frontend-build

# Set up npm workspace so @evoapi/evonexus-ui resolves as a local package
WORKDIR /workspace
COPY dashboard/package.json ./
COPY dashboard/packages/ packages/
COPY dashboard/frontend/package.json frontend/
COPY dashboard/frontend/package-lock.json* frontend/
RUN npm install
COPY dashboard/frontend/ frontend/
WORKDIR /workspace/frontend
RUN npm run build

# --- Stage 2: Terminal-server build ---
# node-pty requires native compilation (python3 + make + g++).
# We compile node_modules here and copy only the result to the runtime stage.
FROM node:22-slim AS terminal-build

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/terminal-server
COPY dashboard/terminal-server/package.json ./
COPY dashboard/terminal-server/package-lock.json* ./
RUN npm install --omit=dev

# --- Stage 3: Python backend ---
FROM python:3.12-slim AS runtime

# System deps: curl/git for healthcheck + brain-repo; Node.js 22 via NodeSource for provider CLIs.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg openssl git \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Provider CLIs — providers.py calls shutil.which("claude") / shutil.which("openclaude")
# inside this container. Without these binaries every toggle stays disabled in the UI.
RUN npm install -g \
        @anthropic-ai/claude-code \
        @gitlawb/openclaude@latest

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Timezone
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /workspace

# Install Python deps
COPY pyproject.toml uv.lock ./
RUN uv venv .venv && uv sync --no-dev

# Copy backend code
COPY dashboard/backend/ dashboard/backend/
COPY social-auth/ social-auth/
COPY scheduler.py ./

# Copy workspace assets the backend reads at runtime.
# Without these, /api/agents, /api/skills, /api/commands etc. all return empty
# and the UI shows "No agents found" / "No skills found" on a fresh deploy.
# .claude/agent-memory and .claude/.env are excluded by .dockerignore so user
# data and secrets stay out of the image.
COPY .claude/ .claude/
COPY docs/ docs/

# Copy config example files to a fixed location outside the config volume.
# At runtime the config/ directory is a Docker volume (starts empty), so any
# files written here would be shadowed. We copy them to _config_defaults/ so
# the entrypoint can seed the volume on first boot without needing docker exec.
COPY config/providers.example.json   _config_defaults/providers.example.json
COPY config/workspace.example.yaml   _config_defaults/workspace.example.yaml
COPY config/smart-router.example.json _config_defaults/smart-router.example.json
COPY config/heartbeats.example.yaml  _config_defaults/heartbeats.example.yaml

# Copy built frontend from stage 1
COPY --from=frontend-build /workspace/frontend/dist dashboard/frontend/dist

# Copy terminal-server source + pre-compiled node_modules (with node-pty binaries)
COPY dashboard/terminal-server/ dashboard/terminal-server/
COPY --from=terminal-build /build/terminal-server/node_modules dashboard/terminal-server/node_modules

# Create data directory for SQLite
RUN mkdir -p dashboard/data

# Bootstrap entrypoint: seeds config volume from _config_defaults on first boot
# then hands off to the original Flask CMD.
RUN printf '#!/bin/sh\n\
# Seed config volume with example files if not present\n\
for src in /workspace/_config_defaults/*; do\n\
  base=$(basename "$src")\n\
  dest="/workspace/config/$base"\n\
  if [ ! -f "$dest" ]; then\n\
    cp "$src" "$dest"\n\
  fi\n\
done\n\
exec "$@"\n' > /usr/local/bin/init-config.sh && chmod +x /usr/local/bin/init-config.sh

# Default ports
ENV EVONEXUS_PORT=8080
ENV TERMINAL_SERVER_PORT=32352
EXPOSE 8080
EXPOSE 32352

# Multi-process entrypoint: starts terminal-server (port 32352) + Flask (port 8080)
COPY start-dashboard.sh /usr/local/bin/start-dashboard.sh
RUN chmod +x /usr/local/bin/start-dashboard.sh

# init-config.sh seeds the config volume on first boot, then hands off to start-dashboard.sh
ENTRYPOINT ["/usr/local/bin/init-config.sh"]
CMD ["/usr/local/bin/start-dashboard.sh"]
